+# ---------------------------------------------------------------- T5 wariancja szumu
+def t5():
+    Nn, sigma, tau = 400, 2.0, 20.0
+    one = SimpleNamespace(W=np.zeros((Nn, Nn)))
+    out = {}
+    for dt in LADDER:
+        for label, ref_dt in (("scaled", 1.0), ("per_step_old", None)):
+            if label == "per_step_old" and dt not in (1.0, 0.1):
