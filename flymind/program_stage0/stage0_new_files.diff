+        sp[0, 0] = True
+        rs = []
+        for b in range(n // k_bin):                      # dt przekazane jawnie; r nie zależy od podziału na chunki
+            for row in sp[b * k_bin:(b + 1) * k_bin]:
+                dec.step(row[None, :], dt)
+                rs.append(dec.r[0])
+        rs = np.array(rs)
