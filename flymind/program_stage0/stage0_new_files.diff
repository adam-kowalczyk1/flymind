+# ---------------------------------------------------------------- T9 nienaruszone pliki zamrożone
+def t9(t_start):
+    cfg = json.load(open(os.path.join(HERE, "results", "v5v41", "config.json")))["code_sha256"]
+    base = json.load(open(os.path.join(HERE, "results", "v5v41", "integrity_baseline.json")))["protected"]
